# ─────────────────────────────────────────────────────────────────────────────
# VANTS Discord Bot - Variables de Entorno
# ─────────────────────────────────────────────────────────────────────────────

# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=1546641331927908472

# Base de datos: Cloudflare D1 (vants-db) por API REST. Todo en Cloudflare.
# Token con permiso D1 (Dashboard -> Mi perfil -> API Tokens -> Editar D1).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_D1_ID=11e5d82c-307b-44ba-9682-501d8df593d3
# Puerto para health check (Railway/Render)
PORT=8080

# Supervisor de la web (Vants Supervisor Bot): DM del dueno que recibe las alertas
SUPERVISOR_DM_ID=1532612429295521930
# Segundos entre ciclos de envio (opcional, por defecto 25)
SUPERVISOR_INTERVAL=25

# ── Agente VANTS (opcional, ruta instantanea) ────────────────────────────────
# El núcleo del agente vive en el cuartel VANTSNET/flask-Agents
# (services/agent-service). Si publicas ese servicio HTTP :8082 (Railway/Render/
# VPS junto a este bot), define AGENT_URL y /agente comando respondera al
# instante. Sin AGENT_URL, las ordenes quedan en la base (agent_comandos) y las
# procesa el ciclo del cuartel (workflow agente.yml cada 30 min); las
# respuestas llegan por DM.
AGENT_URL=
AGENT_TOKEN=
# Segundos entre ciclos del puente agente<->Discord (por defecto 25)
AGENTE_BRIDGE_INTERVAL=25

# ─────────────────────────────────────────────────────────────────────────────
# Instrucciones:
# 1. Copia este archivo a .env
# 2. Rellena los valores vacíos
# 3. NUNCA subas el archivo .env al repo
# ─────────────────────────────────────────────────────────────────────────────
